# App
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=vFurst
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vfurst?schema=public

# Auth.js / NextAuth
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Stripe Connect
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CLIENT_ID=ca_replace_me
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/api/stripe/refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/api/stripe/return

# Redis / background jobs
REDIS_URL=redis://localhost:6379

# AWS S3 and SES
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
S3_BUCKET=vfurst-dev-assets
SES_FROM_EMAIL=no-reply@vfurst.app

# SMTP fallback
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@localhost

# Vercel deploy workflow
VERCEL_ORG_ID=replace_me
VERCEL_PROJECT_ID=replace_me
VERCEL_TOKEN=replace_me
