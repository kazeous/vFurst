# Local development template. Copy values into `.env.local` and replace
# placeholder secrets before running real integrations.

NODE_ENV=development
NEXT_PUBLIC_APP_NAME=vFurst
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# Docker Compose services
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vfurst?schema=public
REDIS_URL=redis://localhost:6379

# MinIO, S3-compatible local storage. Remove S3_ENDPOINT after Phase 7 when
# switching to real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=vfurst-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Mailpit local SMTP catcher. View sent mail at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@localhost

# Stripe test mode. Use the Stripe CLI for local webhooks:
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_CLIENT_ID=ca_replace_me
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/api/stripe/return
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/api/stripe/refresh
SEPAY_ENV=sandbox
SEPAY_WEBHOOK_SECRET=replace_with_hmac_secret
SEPAY_API_TOKEN=replace_with_sepay_api_v2_token
CHECKOUT_TOKEN_SECRET=replace_with_random_secret

# Auth.js
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-random-local-secret
AUTH_TRUST_HOST=true

# Launch monitoring and pressure controls
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
VFURST_LAUNCH_URL=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.02
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
SENTRY_TRACES_SAMPLE_RATE=0.1
VFURST_API_RATE_LIMIT_PER_MINUTE=100
VFURST_AUTH_RATE_LIMIT_PER_MINUTE=30
VFURST_PAYMENT_RATE_LIMIT_PER_MINUTE=60
VFURST_STRIPE_WEBHOOK_RATE_LIMIT_PER_MINUTE=240
