# Staging template. Set real values in the deployment environment secret store.
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=vFurst
NEXT_PUBLIC_APP_URL=https://staging.vfurst.app
NEXT_PUBLIC_ROOT_DOMAIN=staging.vfurst.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vfurst_staging?schema=public
AUTH_SECRET=replace-in-secret-store
AUTH_URL=https://staging.vfurst.app
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CLIENT_ID=ca_replace_me
STRIPE_CONNECT_REFRESH_URL=https://staging.vfurst.app/api/stripe/refresh
STRIPE_CONNECT_RETURN_URL=https://staging.vfurst.app/api/stripe/return
REDIS_URL=redis://USER:PASSWORD@HOST:6379
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-in-secret-store
AWS_SECRET_ACCESS_KEY=replace-in-secret-store
S3_BUCKET=vfurst-staging-assets
SES_FROM_EMAIL=no-reply@staging.vfurst.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@staging.vfurst.app
