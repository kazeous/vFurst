# Allow packages that need install scripts to run them. npm 11+ blocks
# postinstall scripts by default, which prevents @prisma/client from
# generating its client and breaks the build inside Docker images.
#
# Keep this list narrow: only packages whose install scripts are required
# for the build to succeed. Anything not listed here will refuse to run.

@prisma/client:allow-scripts=true
@prisma/engines:allow-scripts=true
prisma:allow-scripts=true
@sentry/cli:allow-scripts=true
esbuild:allow-scripts=true
sharp:allow-scripts=true