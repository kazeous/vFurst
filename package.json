{
  "name": "vfurst",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:load": "node scripts/run-load-test.mjs",
    "test:load:smoke": "node scripts/run-load-test.mjs -e VFURST_LOAD_PROFILE=smoke",
    "seed:load": "node scripts/seed-load-test.mjs",
    "check:launch": "node scripts/check-launch-readiness.mjs",
    "db:validate": "npm run validate --workspace @vfurst/db"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/client-ses": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.2",
    "ioredis": "^5.11.1",
    "next-auth": "^5.0.0-beta.31",
    "stripe": "^22.3.0",
    "zod": "^4.4.3"
  }
}
