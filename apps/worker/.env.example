# Environment contract for @vfurst/worker.
#
# The worker validates this set at import time in src/env.ts and exits with a
# WorkerConfigurationError if anything is missing. It does not read the
# repository-root .env.
#
# For local development, edit the repository-root .env.local instead and run
# `node scripts/sync-app-env.mjs`, which regenerates apps/worker/.env from the
# keys listed here.

NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vfurst?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vfurst?schema=public
VFURST_DB_CONNECTION_LIMIT=4
VFURST_DB_POOL_TIMEOUT_SECONDS=20

# Queues and control-plane invalidation
REDIS_URL=redis://localhost:6379
CONTROL_PLANE_INVALIDATION_CHANNEL=vfurst:control-plane:invalidations

# Email outbox. Must match the web app's key or delivery payloads cannot be
# decrypted. Local development key only; generate a real one per environment
# with: openssl rand -base64 32
EMAIL_DELIVERY_ENCRYPTION_KEY=dmZ1cnN0LWxvY2FsLWRldi1lbWFpbC1rZXktMzJieXQ=

# Object storage for badge assets and uploads
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=vfurst-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Mailpit local SMTP catcher
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_EMAIL=no-reply@localhost

# Links generated inside emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SePay reconciliation
SEPAY_ENV=sandbox
SEPAY_WEBHOOK_SECRET=local-development-sepay-webhook-secret
SEPAY_API_TOKEN=local-development-sepay-api-token

# Optional operational controls
WORKER_HEALTH_PORT=
WORKER_STARTUP_TIMEOUT_MS=30000
