NEXT_PUBLIC_PLATFORM_MANAGER_URL=https://manager.vfurst.reyuugames.com
NEXT_PUBLIC_ROOT_DOMAIN=vfurst.reyuugames.com
AUTH_URL=https://manager.vfurst.reyuugames.com
AUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VFURST_AUTH_CLIENT_ID=tenant-web
VFURST_AUTH_CALLBACK_URLS=https://console.vfurst.reyuugames.com/auth/callback
VFURST_IDENTITY_SERVICE_SECRET=replace-with-a-separate-long-random-service-secret
VFURST_MANAGER_IDENTITY_PRIVATE_KEY_BASE64=base64-encoded-ed25519-pkcs8-pem
VFURST_MANAGER_IDENTITY_KEY_ID=manager-2026-01
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vfurst?schema=public
REDIS_URL=redis://localhost:6379
# Set only when the ingress strips client-supplied copies and writes this header.
# Without it, rate limiting deliberately uses a shared untrusted-proxy bucket.
VFURST_TRUSTED_CLIENT_IP_HEADER=
VFURST_MANAGER_RATE_LIMIT_PREFIX=vfurst:manager:rate-limit
# Credential checks use both buckets: per normalized account and per client IP.
VFURST_MANAGER_CREDENTIAL_ACCOUNT_RATE_LIMIT_PER_MINUTE=10
VFURST_MANAGER_CREDENTIAL_IP_RATE_LIMIT_PER_MINUTE=50
VFURST_MANAGER_AUTHORIZE_RATE_LIMIT_PER_MINUTE=60
VFURST_MANAGER_EXCHANGE_RATE_LIMIT_PER_MINUTE=600
VFURST_MANAGER_REVOKE_RATE_LIMIT_PER_MINUTE=600
