{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@vfurst/auth": [
        "../../packages/auth/src/index.ts"
      ],
      "@vfurst/auth/*": [
        "../../packages/auth/src/*.ts"
      ],
      "@vfurst/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@vfurst/db": [
        "../../packages/db/src/index.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
