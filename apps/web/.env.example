# Environment contract for @vfurst/web.
#
# Next.js only reads .env files from the application directory, so this app
# needs its own file. Do not rely on the repository-root .env — nothing loads it
# into this process.
#
# For local development, edit the repository-root .env.local instead and run
# `node scripts/sync-app-env.mjs`, which regenerates apps/web/.env.local from
# the keys listed here. In deployed environments the platform supplies these
# variables directly and no file is needed.
#
# `node scripts/check-app-env.mjs web` validates the required set at startup.
#
# NEXT_PUBLIC_* values are inlined into the bundle at build time, including in
# server code. Changing one requires a rebuild; setting it only at runtime has
# no effect. Keep NEXT_PUBLIC_APP_URL in agreement with scripts/run-e2e.mjs.

NODE_ENV=development
NEXT_PUBLIC_APP_NAME=vFurst
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MANAGER_URL=http://localhost:3000
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# Database. DATABASE_URL is the runtime endpoint and may point at a pooler;
# DIRECT_DATABASE_URL must bypass transaction pooling for schema work.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vfurst?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vfurst?schema=public
VFURST_DB_CONNECTION_LIMIT=4
VFURST_DB_POOL_TIMEOUT_SECONDS=20
VFURST_DB_CONNECTION_BUDGET=80
VFURST_WEB_REPLICAS=6
VFURST_WORKER_REPLICAS=1

# Shared rate limiting. Without this the limiter fails closed and every paid
# flow returns a server error.
REDIS_URL=redis://localhost:6379
VFURST_RATE_LIMIT_PREFIX=vfurst:rate-limit
VFURST_API_RATE_LIMIT_PER_MINUTE=100
VFURST_AUTH_RATE_LIMIT_PER_MINUTE=30
VFURST_PAYMENT_RATE_LIMIT_PER_MINUTE=60
VFURST_STRIPE_WEBHOOK_RATE_LIMIT_PER_MINUTE=240
VFURST_SEPAY_WEBHOOK_RATE_LIMIT_PER_MINUTE=240

# Email outbox. The web app writes the encrypted EmailDelivery record, so it
# needs the same key as the worker. Local development key only; generate a real
# one per environment with: openssl rand -base64 32
EMAIL_DELIVERY_ENCRYPTION_KEY=dmZ1cnN0LWxvY2FsLWRldi1lbWFpbC1rZXktMzJieXQ=

# Object storage. Remove S3_ENDPOINT when switching to real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=vfurst-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Mailpit local SMTP catcher. View sent mail at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_EMAIL=no-reply@localhost
SALES_CONTACT_EMAIL=sales@vfurst.com

# Auth.js. The secret below is a working local default; use a random value per
# deployed environment.
AUTH_URL=http://localhost:3000
AUTH_SECRET=local-development-secret-do-not-share-or-deploy
AUTH_TRUST_HOST=true

# Payments. Stripe test mode; use the Stripe CLI for local webhooks:
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_CLIENT_ID=ca_replace_me
SEPAY_ENV=sandbox
SEPAY_WEBHOOK_SECRET=local-development-sepay-webhook-secret
SEPAY_API_TOKEN=local-development-sepay-api-token
CHECKOUT_TOKEN_SECRET=local-development-checkout-token-secret-32b

# Monitoring. Leave blank locally unless verifying launch readiness against a
# deployed environment.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
VFURST_LAUNCH_URL=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.02
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
SENTRY_TRACES_SAMPLE_RATE=0.1
