VFURST_TENANT_ROOT_DOMAIN=vfurst.reyuugames.com
VFURST_MANAGER_URL=https://manager.vfurst.reyuugames.com
VFURST_CONSOLE_URL=https://console.vfurst.reyuugames.com
VFURST_API_URL=https://api.vfurst.reyuugames.com
VFURST_AUTH_CLIENT_ID=tenant-web
# Generate 32 random bytes and encode them as unpadded base64url.
VFURST_AUTH_TRANSACTION_KEY_BASE64URL=replace-with-43-base64url-characters
# Generate at least 32 random bytes and encode them as unpadded base64url.
VFURST_TENANT_SESSION_SECRET_BASE64URL=replace-with-at-least-43-base64url-characters
# JSON map of manager Ed25519 key id to PEM public key. Keep old keys during rotation.
VFURST_MANAGER_IDENTITY_PUBLIC_KEYS_JSON={"manager-2026-01":"-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----"}
# Shared only by tenant-web and platform-manager service-to-service requests.
VFURST_IDENTITY_SERVICE_SECRET=replace-with-a-long-random-service-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vfurst?schema=public
REDIS_URL=redis://localhost:6379
