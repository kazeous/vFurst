generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum OrganizationStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  RETIRED
}

enum CustomDomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  REJECTED
  DISABLED
}

enum CurrencyCode {
  USD
  VND
}

enum PaymentProvider {
  STRIPE
  SEPAY
}

enum PaymentAttemptStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
  REVIEW
}

enum PaymentExceptionType {
  UNKNOWN_CODE
  LATE_PAYMENT
  STALE_ATTEMPT
  UNDERPAID
  OVERPAID
  ACCOUNT_MISMATCH
  INVALID_TRANSFER
}

enum PaymentExceptionStatus {
  OPEN
  RESOLVED
  REFUNDED
}

enum OrganizerLedgerEntryType {
  PAYMENT
  REFUND
  ADJUSTMENT
}

enum OrganizerLedgerEntryStatus {
  OPEN
  SETTLED
}

enum EmailProviderType {
  SES
  SMTP
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  TRANSFERRED
  CHECKED_IN
}

enum RegistrationApprovalStatus {
  APPROVED
  PENDING
  REJECTED
}

enum RegistrationTransferRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum VolunteerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StaffAssignmentStatus {
  ASSIGNED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum VendorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
}

enum CartItemType {
  REGISTRATION
  ADDON
  PRODUCT
}

enum OrderStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
  FAILED
}

enum OrderItemType {
  REGISTRATION
  ADDON
  PRODUCT
  HOTEL
  VENDOR
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum RaffleEntryMethod {
  AUTO
  MANUAL
  PURCHASED
}

model User {
  id                        String                  @id @default(uuid()) @db.Uuid
  email                     String                  @unique
  name                      String?
  avatar                    String?
  image                     String?
  emailVerified             DateTime?
  passwordHash              String?
  authVersion               Int                     @default(0)
  platformRole              PlatformRole            @default(USER)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  accounts                  Account[]
  attendeeNotes             AttendeeNote[]          @relation("AttendeeNoteAuthor")
  authenticators            Authenticator[]
  carts                     Cart[]
  hotelBookings             HotelBooking[]
  ledDepartments            Department[]            @relation("DepartmentLead")
  orders                    Order[]
  orgMemberships            OrgMember[]
  raffleEntries             RaffleEntry[]
  registrations             Registration[]
  reviewedApplications      VolunteerApplication[]  @relation("VolunteerApplicationReviewer")
  sessions                  Session[]
  staffAssignments          StaffAssignment[]
  vendorApplications        VendorApplication[]
  volunteerApplications     VolunteerApplication[]
  paymentProviderUpdates    PaymentProviderConfig[] @relation("PaymentProviderUpdatedBy")
  organizerPayoutsCreated   OrganizerPayout[]       @relation("OrganizerPayoutCreatedBy")
  paymentRefundsCreated     PaymentRefund[]         @relation("PaymentRefundCreatedBy")
  paymentExceptionsResolved PaymentException[]      @relation("PaymentExceptionResolvedBy")
  organizationStatusUpdates Organization[]          @relation("OrganizationStatusUpdatedBy")
  customDomainsVerified     Organization[]          @relation("OrganizationCustomDomainVerifiedBy")
  customDomainsActivated    Organization[]          @relation("OrganizationCustomDomainActivatedBy")
  orgInvitationsSent        OrgInvitation[]         @relation("OrgInvitationInvitedBy")
  orgInvitationsAccepted    OrgInvitation[]         @relation("OrgInvitationAcceptedBy")
  orgInvitationsRevoked     OrgInvitation[]         @relation("OrgInvitationRevokedBy")
  registrationTransferRequestsCreated RegistrationTransferRequest[] @relation("RegistrationTransferRequester")
  registrationTransferRequestsReceived RegistrationTransferRequest[] @relation("RegistrationTransferRecipient")

  @@map("users")
}

model Organization {
  id                         String                  @id @default(uuid()) @db.Uuid
  name                       String
  slug                       String                  @unique
  subdomain                  String                  @unique
  status                     OrganizationStatus      @default(PROVISIONING)
  statusUpdatedById          String?                 @db.Uuid
  statusUpdatedAt            DateTime?
  logo                       String?
  contactEmail               String
  requestedCustomDomain      String?
  customDomain               String?                 @unique
  customDomainStatus         CustomDomainStatus?
  customDomainVerifiedById   String?                 @db.Uuid
  customDomainVerifiedAt     DateTime?
  customDomainActivatedById  String?                 @db.Uuid
  customDomainActivatedAt    DateTime?
  emailProvider              EmailProviderType       @default(SMTP)
  emailSettings              Json                    @default("{}")
  payoutBankCode             String?
  payoutAccountNumber        String?
  payoutAccountHolder        String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  addOnDefinitions       AddOnDefinition[]
  apiKeys                ApiKey[]
  attendeeNotes          AttendeeNote[]
  badgeTemplates         BadgeTemplate[]
  badges                 Badge[]
  cartItems              CartItem[]
  carts                  Cart[]
  departments            Department[]
  events                 Event[]
  hotelBlocks            HotelBlock[]
  hotelBookings          HotelBooking[]
  invitations            OrgInvitation[]
  members                OrgMember[]
  orderItems             OrderItem[]
  orders                 Order[]
  raffleEntries          RaffleEntry[]
  raffles                Raffle[]
  registrationTypes      RegistrationType[]
  registrationAddOns     RegistrationAddOn[]
  registrations          Registration[]
  registrationTransferRequests RegistrationTransferRequest[]
  staffAssignments       StaffAssignment[]
  staffRoles             StaffRole[]
  storeProducts          StoreProduct[]
  stripeConnect          StripeConnect?
  vendorApplications     VendorApplication[]
  volunteerApplications  VolunteerApplication[]
  vouchers               Voucher[]
  webhookEndpoints       WebhookEndpoint[]
  organizerLedgerEntries OrganizerLedgerEntry[]
  organizerPayouts       OrganizerPayout[]
  statusUpdatedBy        User?                   @relation("OrganizationStatusUpdatedBy", fields: [statusUpdatedById], references: [id], onDelete: SetNull)
  customDomainVerifiedBy User?                   @relation("OrganizationCustomDomainVerifiedBy", fields: [customDomainVerifiedById], references: [id], onDelete: SetNull)
  customDomainActivatedBy User?                  @relation("OrganizationCustomDomainActivatedBy", fields: [customDomainActivatedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([statusUpdatedById])
  @@index([customDomainStatus])
  @@index([requestedCustomDomain])
  @@index([customDomainVerifiedById])
  @@index([customDomainActivatedById])
  @@map("organizations")
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Authenticator {
  credentialID         String  @unique
  userId               String  @db.Uuid
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@map("authenticators")
}

model OrgMember {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  orgId     String       @db.Uuid
  role      OrgRole      @default(MEMBER)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
  @@map("org_members")
}

model OrgInvitation {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @db.Uuid
  email        String
  role         OrgRole
  tokenHash    String       @unique @db.Char(64)
  invitedById  String       @db.Uuid
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?      @db.Uuid
  revokedAt    DateTime?
  revokedById  String?      @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("OrgInvitationInvitedBy", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("OrgInvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedBy    User?        @relation("OrgInvitationRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([orgId, email])
  @@index([orgId, createdAt])
  @@index([expiresAt])
  @@index([invitedById])
  @@index([acceptedById])
  @@index([revokedById])
  @@map("org_invitations")
}

model StripeConnect {
  id                 String       @id @default(uuid()) @db.Uuid
  orgId              String       @unique @db.Uuid
  stripeAccountId    String       @unique
  onboardingComplete Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("stripe_connect")
}

model Event {
  id                    String                 @id @default(uuid()) @db.Uuid
  orgId                 String                 @db.Uuid
  name                  String
  slug                  String
  description           String?
  startDate             DateTime
  endDate               DateTime
  venue                 String?
  status                EventStatus            @default(DRAFT)
  currency              CurrencyCode           @default(USD)
  settings              Json                   @default("{\"requireApproval\":false,\"allowTransfers\":true,\"maxRegistrationsPerUser\":1}")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  badgeTemplates        BadgeTemplate[]
  carts                 Cart[]
  departments           Department[]
  hotelBlocks           HotelBlock[]
  orders                Order[]
  org                   Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  raffles               Raffle[]
  registrationTypes     RegistrationType[]
  registrations         Registration[]
  registrationTransferRequests RegistrationTransferRequest[]
  storeProducts         StoreProduct[]
  vendorApplications    VendorApplication[]
  volunteerApplications VolunteerApplication[]
  vouchers              Voucher[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([status])
  @@index([orgId, status, startDate])
  @@map("events")
}

model RegistrationType {
  id               String            @id @default(uuid()) @db.Uuid
  orgId            String            @db.Uuid
  eventId          String            @db.Uuid
  name             String
  price            Int
  maxCapacity      Int?
  scheduledPricing Json              @default("[]")
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  addOns           AddOnDefinition[]
  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  registrations    Registration[]

  @@index([orgId])
  @@index([eventId])
  @@map("registration_types")
}

model AddOnDefinition {
  id                 String              @id @default(uuid()) @db.Uuid
  orgId              String              @db.Uuid
  registrationTypeId String              @db.Uuid
  name               String
  price              Int
  isComplimentary    Boolean             @default(false)
  maxQuantity        Int                 @default(1)
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  registrationAddOns RegistrationAddOn[]
  registrationType   RegistrationType    @relation(fields: [registrationTypeId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([registrationTypeId])
  @@map("add_on_definitions")
}

model Registration {
  id                String              @id @default(uuid()) @db.Uuid
  orgId             String              @db.Uuid
  eventId           String              @db.Uuid
  userId            String              @db.Uuid
  typeId            String              @db.Uuid
  status            RegistrationStatus  @default(PENDING)
  approvalStatus    RegistrationApprovalStatus @default(APPROVED)
  checkedInAt       DateTime?
  badgeNumber       String?
  transferredFromId String?             @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  addOns            RegistrationAddOn[]
  attendeeNotes     AttendeeNote[]
  badges            Badge[]
  event             Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
  org               Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transferredFrom   Registration?       @relation("RegistrationTransfer", fields: [transferredFromId], references: [id])
  transferredTo     Registration[]      @relation("RegistrationTransfer")
  transferRequests  RegistrationTransferRequest[] @relation("RegistrationTransferSource")
  type              RegistrationType    @relation(fields: [typeId], references: [id])
  user              User                @relation(fields: [userId], references: [id])

  @@unique([eventId, badgeNumber])
  @@index([orgId])
  @@index([eventId])
  @@index([eventId, status])
  @@index([eventId, userId, status])
  @@index([eventId, createdAt])
  @@index([eventId, checkedInAt])
  @@index([userId])
  @@index([typeId])
  @@index([typeId, status])
  @@map("registrations")
}

model RegistrationTransferRequest {
  id                   String                              @id @default(uuid()) @db.Uuid
  orgId                String                              @db.Uuid
  eventId              String                              @db.Uuid
  sourceRegistrationId String                              @db.Uuid
  requesterUserId      String                              @db.Uuid
  recipientEmail       String
  recipientUserId      String?                             @db.Uuid
  tokenHash            String                              @unique @db.Char(64)
  status               RegistrationTransferRequestStatus   @default(PENDING)
  expiresAt            DateTime
  acceptedAt           DateTime?
  declinedAt           DateTime?
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt
  event                Event                               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  org                  Organization                        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sourceRegistration   Registration                        @relation("RegistrationTransferSource", fields: [sourceRegistrationId], references: [id], onDelete: Cascade)
  requester            User                                @relation("RegistrationTransferRequester", fields: [requesterUserId], references: [id])
  recipient            User?                               @relation("RegistrationTransferRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([orgId, status])
  @@index([sourceRegistrationId, status])
  @@index([recipientEmail, status])
  @@index([expiresAt])
  @@map("registration_transfer_requests")
}

model RegistrationAddOn {
  id                String          @id @default(uuid()) @db.Uuid
  orgId             String          @db.Uuid
  registrationId    String          @db.Uuid
  addOnDefinitionId String          @db.Uuid
  price             Int
  quantity          Int             @default(1)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  addOnDefinition   AddOnDefinition @relation(fields: [addOnDefinitionId], references: [id])
  org               Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  registration      Registration    @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([registrationId])
  @@index([addOnDefinitionId])
  @@map("registration_add_ons")
}

model Badge {
  id             String        @id @default(uuid()) @db.Uuid
  orgId          String        @db.Uuid
  registrationId String        @db.Uuid
  templateId     String        @db.Uuid
  barcodeData    String        @unique
  nfcTag         String?       @unique
  pdfUrl         String?       @db.Text
  zplData        String?       @db.Text
  generatedAt    DateTime?
  printedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  template       BadgeTemplate @relation(fields: [templateId], references: [id])

  @@index([orgId])
  @@index([registrationId])
  @@index([templateId])
  @@map("badges")
}

model BadgeTemplate {
  id         String       @id @default(uuid()) @db.Uuid
  orgId      String       @db.Uuid
  eventId    String       @db.Uuid
  name       String
  layout     Json
  dimensions Json
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  badges     Badge[]
  event      Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([eventId])
  @@map("badge_templates")
}

model Department {
  id                    String                 @id @default(uuid()) @db.Uuid
  orgId                 String                 @db.Uuid
  eventId               String                 @db.Uuid
  name                  String
  leadUserId            String?                @db.Uuid
  formSchema            Json                   @default("[]")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  event                 Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  leadUser              User?                  @relation("DepartmentLead", fields: [leadUserId], references: [id])
  org                   Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  roles                 StaffRole[]
  volunteerApplications VolunteerApplication[]

  @@index([orgId])
  @@index([eventId])
  @@index([leadUserId])
  @@map("departments")
}

model VolunteerApplication {
  id               String                     @id @default(uuid()) @db.Uuid
  orgId            String                     @db.Uuid
  userId           String                     @db.Uuid
  departmentId     String                     @db.Uuid
  eventId          String                     @db.Uuid
  formResponses    Json                       @default("{}")
  availability     Json                       @default("[]")
  status           VolunteerApplicationStatus @default(PENDING)
  reviewedById     String?                    @db.Uuid
  reviewedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  department       Department                 @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  event            Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  org              Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reviewedBy       User?                      @relation("VolunteerApplicationReviewer", fields: [reviewedById], references: [id])
  staffAssignments StaffAssignment[]
  user             User                       @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([eventId])
  @@index([departmentId])
  @@index([userId])
  @@index([eventId, status])
  @@map("volunteer_applications")
}

model StaffRole {
  id            String            @id @default(uuid()) @db.Uuid
  orgId         String            @db.Uuid
  departmentId  String            @db.Uuid
  roleName      String
  shifts        Json              @default("[]")
  maxVolunteers Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  assignments   StaffAssignment[]
  department    Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  org           Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([departmentId])
  @@map("staff_roles")
}

model StaffAssignment {
  id                     String                @id @default(uuid()) @db.Uuid
  orgId                  String                @db.Uuid
  userId                 String                @db.Uuid
  roleId                 String                @db.Uuid
  volunteerApplicationId String?               @db.Uuid
  shiftSlot              Json
  status                 StaffAssignmentStatus @default(ASSIGNED)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  org                    Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role                   StaffRole             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user                   User                  @relation(fields: [userId], references: [id])
  volunteerApplication   VolunteerApplication? @relation(fields: [volunteerApplicationId], references: [id])

  @@index([orgId])
  @@index([roleId])
  @@index([userId])
  @@index([volunteerApplicationId])
  @@map("staff_assignments")
}

model VendorApplication {
  id                 String                  @id @default(uuid()) @db.Uuid
  orgId              String                  @db.Uuid
  eventId            String                  @db.Uuid
  userId             String                  @db.Uuid
  businessName       String
  contactName        String?
  contactEmail       String?
  website            String?
  productDescription String?
  tableType          String?
  boothPrice         Int                     @default(0)
  boothAssignment    String?
  boothPaidAt        DateTime?
  paymentOrderId     String?                 @db.Uuid
  status             VendorApplicationStatus @default(PENDING)
  assistants         Json                    @default("[]")
  amenities          Json                    @default("[]")
  files              Json                    @default("[]")
  preferences        Json                    @default("{}")
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  event              Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  org                Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user               User                    @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([eventId])
  @@index([userId])
  @@index([paymentOrderId])
  @@index([eventId, status])
  @@map("vendor_applications")
}

model StoreProduct {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @db.Uuid
  eventId     String       @db.Uuid
  name        String
  description String?
  price       Int
  stock       Int
  images      Json         @default("[]")
  category    String?
  surcharges  Json         @default("[]")
  options     Json         @default("[]")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([eventId])
  @@map("store_products")
}

model Cart {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @db.Uuid
  userId    String       @db.Uuid
  eventId   String       @db.Uuid
  voucherId String?      @db.Uuid
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items     CartItem[]
  orders    Order[]
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucher   Voucher?     @relation(fields: [voucherId], references: [id])

  @@unique([userId, eventId])
  @@index([orgId])
  @@index([eventId])
  @@index([voucherId])
  @@map("carts")
}

model CartItem {
  id             String        @id @default(uuid()) @db.Uuid
  orgId          String        @db.Uuid
  cartId         String        @db.Uuid
  itemType       CartItemType
  refId          String        @db.Uuid
  unitPrice      Int
  quantity       Int           @default(1)
  metadata       Json          @default("{}")
  storeProductId String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  cart           Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product        StoreProduct? @relation(fields: [storeProductId], references: [id])

  @@index([orgId])
  @@index([cartId])
  @@index([itemType, refId])
  @@index([storeProductId])
  @@map("cart_items")
}

model Order {
  id                    String                 @id @default(uuid()) @db.Uuid
  orgId                 String                 @db.Uuid
  userId                String                 @db.Uuid
  eventId               String                 @db.Uuid
  cartId                String?                @db.Uuid
  total                 Int
  platformFee           Int
  currency              CurrencyCode           @default(USD)
  status                OrderStatus            @default(PENDING)
  paymentProvider       PaymentProvider?
  paymentReference      String?
  checkoutTokenHash     String?
  checkoutSuccessPath   String?
  checkoutCancelPath    String?
  checkoutExpiresAt     DateTime?
  inventoryReservedAt   DateTime?
  reservationReleasedAt DateTime?
  stripePaymentIntentId String?                @unique
  voucherId             String?                @db.Uuid
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  cart                  Cart?                  @relation(fields: [cartId], references: [id])
  event                 Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items                 OrderItem[]
  org                   Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user                  User                   @relation(fields: [userId], references: [id])
  voucher               Voucher?               @relation(fields: [voucherId], references: [id])
  paymentAttempts       PaymentAttempt[]
  paymentExceptions     PaymentException[]
  ledgerEntries         OrganizerLedgerEntry[]
  paymentRefund         PaymentRefund?

  @@index([orgId])
  @@index([eventId])
  @@index([userId])
  @@index([cartId])
  @@index([voucherId])
  @@index([eventId, status, createdAt])
  @@index([orgId, status, createdAt])
  @@index([paymentProvider, paymentReference])
  @@index([checkoutTokenHash])
  @@index([checkoutExpiresAt])
  @@map("orders")
}

model PaymentProviderConfig {
  id          String          @id @default(uuid()) @db.Uuid
  provider    PaymentProvider @unique
  enabled     Boolean         @default(false)
  settings    Json            @default("{}")
  updatedById String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  updatedBy   User?           @relation("PaymentProviderUpdatedBy", fields: [updatedById], references: [id])

  @@index([enabled])
  @@map("payment_provider_configs")
}

model PaymentAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  orderId           String               @db.Uuid
  activeOrderId     String?              @unique @db.Uuid
  provider          PaymentProvider
  status            PaymentAttemptStatus @default(PENDING)
  amount            Int
  currency          CurrencyCode
  paymentCode       String?              @unique
  providerReference String?              @unique
  expiresAt         DateTime
  paidAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentExceptions PaymentException[]

  @@index([orderId, status])
  @@index([provider, status, expiresAt])
  @@map("payment_attempts")
}

model SePayWebhookEvent {
  id                 String    @id @default(uuid()) @db.Uuid
  sepayTransactionId String    @unique
  payload            Json
  processedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([processedAt, createdAt])
  @@map("sepay_webhook_events")
}

model SePayReconciliationCursor {
  id        String   @id @default("sepay")
  cursor    String?
  updatedAt DateTime @updatedAt

  @@map("sepay_reconciliation_cursors")
}

model PaymentException {
  id                 String                 @id @default(uuid()) @db.Uuid
  orderId            String?                @db.Uuid
  paymentAttemptId   String?                @db.Uuid
  type               PaymentExceptionType
  status             PaymentExceptionStatus @default(OPEN)
  sepayTransactionId String?                @unique
  providerReference  String?                @unique
  expectedAmount     Int?
  receivedAmount     Int?
  details            Json                   @default("{}")
  resolvedById       String?                @db.Uuid
  resolvedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  order              Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentAttempt     PaymentAttempt?        @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  resolvedBy         User?                  @relation("PaymentExceptionResolvedBy", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@index([orderId])
  @@index([paymentAttemptId])
  @@map("payment_exceptions")
}

model OrganizerLedgerEntry {
  id        String                     @id @default(uuid()) @db.Uuid
  orgId     String                     @db.Uuid
  orderId   String?                    @db.Uuid
  payoutId  String?                    @db.Uuid
  refundId  String?                    @db.Uuid
  type      OrganizerLedgerEntryType
  status    OrganizerLedgerEntryStatus @default(OPEN)
  currency  CurrencyCode
  amount    Int
  note      String?
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
  org       Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  order     Order?                     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payout    OrganizerPayout?           @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  refund    PaymentRefund?             @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@unique([orderId, type])
  @@index([orgId, currency, status, createdAt])
  @@index([payoutId])
  @@map("organizer_ledger_entries")
}

model OrganizerPayout {
  id          String                 @id @default(uuid()) @db.Uuid
  orgId       String                 @db.Uuid
  currency    CurrencyCode
  amount      Int
  reference   String
  paidAt      DateTime
  createdById String                 @db.Uuid
  createdAt   DateTime               @default(now())
  org         Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation("OrganizerPayoutCreatedBy", fields: [createdById], references: [id])
  entries     OrganizerLedgerEntry[]

  @@index([orgId, currency, paidAt])
  @@index([createdById])
  @@map("organizer_payouts")
}

model PaymentRefund {
  id            String                 @id @default(uuid()) @db.Uuid
  orderId       String                 @unique @db.Uuid
  provider      PaymentProvider
  amount        Int
  reference     String
  reason        String?
  processedAt   DateTime
  createdById   String                 @db.Uuid
  createdAt     DateTime               @default(now())
  order         Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy     User                   @relation("PaymentRefundCreatedBy", fields: [createdById], references: [id])
  ledgerEntries OrganizerLedgerEntry[]

  @@index([createdById])
  @@map("payment_refunds")
}

model OrderItem {
  id             String        @id @default(uuid()) @db.Uuid
  orgId          String        @db.Uuid
  orderId        String        @db.Uuid
  itemType       OrderItemType
  refId          String        @db.Uuid
  unitPrice      Int
  quantity       Int           @default(1)
  metadata       Json          @default("{}")
  registrationId String?       @db.Uuid
  storeProductId String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  registration   Registration? @relation(fields: [registrationId], references: [id])
  storeProduct   StoreProduct? @relation(fields: [storeProductId], references: [id])

  @@index([orgId])
  @@index([orderId])
  @@index([itemType, refId])
  @@index([registrationId])
  @@index([storeProductId])
  @@map("order_items")
}

model Voucher {
  id            String       @id @default(uuid()) @db.Uuid
  orgId         String       @db.Uuid
  eventId       String       @db.Uuid
  code          String
  discountType  DiscountType
  discountValue Int
  restrictions  Json         @default("{}")
  maxUses       Int?
  usedCount     Int          @default(0)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  carts         Cart[]
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders        Order[]
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([eventId, code])
  @@index([orgId])
  @@index([eventId])
  @@map("vouchers")
}

model HotelBlock {
  id         String         @id @default(uuid()) @db.Uuid
  orgId      String         @db.Uuid
  eventId    String         @db.Uuid
  hotelName  String
  roomTypes  Json
  cutoffDate DateTime
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  bookings   HotelBooking[]
  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  org        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([eventId])
  @@map("hotel_blocks")
}

model HotelBooking {
  id               String       @id @default(uuid()) @db.Uuid
  orgId            String       @db.Uuid
  userId           String       @db.Uuid
  blockId          String       @db.Uuid
  roomType         String
  checkIn          DateTime
  checkOut         DateTime
  confirmationCode String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  block            HotelBlock   @relation(fields: [blockId], references: [id], onDelete: Cascade)
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([blockId])
  @@index([userId])
  @@map("hotel_bookings")
}

model Raffle {
  id        String        @id @default(uuid()) @db.Uuid
  orgId     String        @db.Uuid
  eventId   String        @db.Uuid
  name      String
  prizes    Json          @default("[]")
  drawDate  DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  entries   RaffleEntry[]
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([eventId])
  @@map("raffles")
}

model RaffleEntry {
  id          String            @id @default(uuid()) @db.Uuid
  orgId       String            @db.Uuid
  raffleId    String            @db.Uuid
  userId      String            @db.Uuid
  entryMethod RaffleEntryMethod
  createdAt   DateTime          @default(now())
  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  raffle      Raffle            @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id])

  @@unique([raffleId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("raffle_entries")
}

model AttendeeNote {
  id             String       @id @default(uuid()) @db.Uuid
  orgId          String       @db.Uuid
  registrationId String       @db.Uuid
  authorId       String       @db.Uuid
  content        String
  createdAt      DateTime     @default(now())
  author         User         @relation("AttendeeNoteAuthor", fields: [authorId], references: [id])
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([registrationId])
  @@index([authorId])
  @@map("attendee_notes")
}

model ApiKey {
  id         String       @id @default(uuid()) @db.Uuid
  orgId      String       @db.Uuid
  name       String
  keyHash    String       @unique
  scopes     String[]
  lastUsedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("api_keys")
}

model WebhookEndpoint {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @db.Uuid
  url       String
  events    String[]
  secret    String
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([active])
  @@map("webhook_endpoints")
}
