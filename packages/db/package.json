{
  "name": "@vfurst/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run generate && npm run clean && tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "lint": "eslint .",
    "backfill:managed-tenancy": "node scripts/backfill-managed-tenancy.mjs",
    "backfill:payment-attempt-locks": "node scripts/backfill-payment-attempt-locks.mjs",
    "cleanup:test-fixtures": "node scripts/cleanup-test-fixtures.mjs --apply",
    "prepare:payment-attempt-locks": "node scripts/prepare-payment-attempt-locks.mjs",
    "push": "prisma db push --skip-generate",
    "sync": "npm run prepare:payment-attempt-locks && npm run push && npm run backfill:managed-tenancy && npm run backfill:payment-attempt-locks",
    "pretype-check": "prisma generate",
    "type-check": "tsc --noEmit",
    "test": "prisma generate && vitest run --passWithNoTests",
    "validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
