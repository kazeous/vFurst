{
  "name": "@vfurst/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run generate && npm run clean && tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "lint": "eslint .",
    "backfill:managed-tenancy": "node scripts/backfill-managed-tenancy.mjs",
    "push": "prisma db push --skip-generate",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
