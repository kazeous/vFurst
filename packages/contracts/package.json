    "build": "npm run clean && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "4.6.6"
  }
}
