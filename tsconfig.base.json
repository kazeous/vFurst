{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "apps/web/src/*"
      ],
      "@vfurst/auth": [
        "packages/auth/src/index.ts"
      ],
      "@vfurst/auth/*": [
        "packages/auth/src/*"
      ],
      "@vfurst/db": [
        "packages/db/src/index.ts"
      ],
      "@vfurst/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@vfurst/email": [
        "packages/email/src/index.ts"
      ],
      "@vfurst/tenant-context": [
        "packages/tenant-context/src/index.ts"
      ],
      "@vfurst/tenant-context/prisma": [
        "packages/tenant-context/src/prisma.ts"
      ]
    }
  }
}
