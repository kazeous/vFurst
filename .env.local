# Local development source of truth. Replace placeholder secrets before running
# real integrations.
#
# No application reads this file directly: Next.js only loads `.env*` from the
# application directory. Run `node scripts/sync-app-env.mjs` after editing (it
# also runs automatically on `npm run dev`) to regenerate apps/web/.env.local
# and apps/worker/.env from the keys each app declares in its own .env.example.

NODE_ENV=development
NEXT_PUBLIC_APP_NAME=vFurst
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MANAGER_URL=http://localhost:3000
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# Docker Compose services
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vfurst?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vfurst?schema=public
REDIS_URL=redis://localhost:6379
# Local development key only; it is committed on purpose so the stack runs out
# of the box. Generate a real one per environment: openssl rand -base64 32
EMAIL_DELIVERY_ENCRYPTION_KEY=dmZ1cnN0LWxvY2FsLWRldi1lbWFpbC1rZXktMzJieXQ=
VFURST_DB_CONNECTION_LIMIT=4
VFURST_DB_POOL_TIMEOUT_SECONDS=20
VFURST_DB_CONNECTION_BUDGET=80
VFURST_WEB_REPLICAS=6
VFURST_WORKER_REPLICAS=1

# Worker runtime
CONTROL_PLANE_INVALIDATION_CHANNEL=vfurst:control-plane:invalidations
WORKER_HEALTH_PORT=
WORKER_STARTUP_TIMEOUT_MS=30000

# MinIO, S3-compatible local storage. Remove S3_ENDPOINT after Phase 7 when
# switching to real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=vfurst-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Mailpit local SMTP catcher. View sent mail at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_EMAIL=no-reply@localhost
SALES_CONTACT_EMAIL=sales@vfurst.com

# Stripe test mode. Use the Stripe CLI for local webhooks:
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
SEPAY_ENV=sandbox
SEPAY_WEBHOOK_SECRET=local-development-sepay-webhook-secret
SEPAY_API_TOKEN=local-development-sepay-api-token
CHECKOUT_TOKEN_SECRET=local-development-checkout-token-secret-32b

# Auth.js
AUTH_URL=http://localhost:3000
AUTH_SECRET=local-development-secret-do-not-share-or-deploy
AUTH_TRUST_HOST=true

# Staff sign-in through the studio identity provider (authentik over OIDC).
# Local development and E2E use the mock-oidc service from docker-compose.yml;
# deployed environments use the authentik application issuer and its
# confidential client credentials.
AUTH_AUTHENTIK_ISSUER=http://localhost:8090/vfurst
AUTH_AUTHENTIK_ID=vfurst-local
AUTH_AUTHENTIK_SECRET=vfurst-local-mock-secret
VFURST_PLATFORM_ADMIN_GROUP=vfurst-platform-admins
VFURST_STAFF_SESSION_MAX_AGE_SECONDS=43200

# Launch monitoring and pressure controls. Leave blank locally unless you are
# verifying Phase 7 launch readiness against a deployed environment.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
VFURST_LAUNCH_URL=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.02
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
SENTRY_TRACES_SAMPLE_RATE=0.1
VFURST_API_RATE_LIMIT_PER_MINUTE=100
VFURST_AUTH_RATE_LIMIT_PER_MINUTE=30
VFURST_PAYMENT_RATE_LIMIT_PER_MINUTE=60
VFURST_STRIPE_WEBHOOK_RATE_LIMIT_PER_MINUTE=240
VFURST_SEPAY_WEBHOOK_RATE_LIMIT_PER_MINUTE=240
VFURST_RATE_LIMIT_PREFIX=vfurst:rate-limit
