generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  organizationMemberships OrganizationMember[]
  eventMemberships        EventMember[]
  attendeeProfiles        AttendeeProfile[]
  registrations           Registration[]
  checkedInRegistrations  Registration[] @relation("RegistrationCheckedInBy")
  carts                   Cart[]
  orders                  Order[]
  vendorApplications      VendorApplication[] @relation("VendorApplicant")
  reviewedVendorApplications VendorApplication[] @relation("VendorReviewer")
  volunteerApplications   VolunteerApplication[] @relation("VolunteerApplicant")
  reviewedVolunteerApplications VolunteerApplication[] @relation("VolunteerReviewer")
  ledVolunteerDepartments VolunteerDepartment[] @relation("VolunteerDepartmentLead")
  createdVolunteerAssignments VolunteerAssignment[] @relation("VolunteerAssignmentCreator")
  markedPayments          Payment[] @relation("PaymentMarkedBy")
  createdRefunds          Refund[]  @relation("RefundCreatedBy")
  createdOrganizationInvites OrganizationInvite[] @relation("OrganizationInviteCreator")
  createdEventInvites        EventInvite[]        @relation("EventInviteCreator")
  auditLogs     AuditLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum EventRole {
  EVENT_ADMIN
  STAFF
  VIEWER
}

enum EventStatus {
  DRAFT
  REGISTRATION_OPEN
  LIVE
  CLOSED
  ARCHIVED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ProductCategory {
  REGISTRATION
  MERCH
  VENDOR_TABLE
  ADD_ON
  DONATION
  SERVICE
}

enum RegistrationStatus {
  SUBMITTED
  CANCELLED
}

enum RegistrationQuestionType {
  SHORT_TEXT
  LONG_TEXT
  CHECKBOX
}

enum BadgeStatus {
  NOT_PRINTED
  PRINT_READY
  PRINTED
  VOID
}

enum OrderStatus {
  UNPAID
  PAID
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  FULFILLED
}

enum PaymentProvider {
  STRIPE
  OFFLINE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum VendorApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED_UNPAID
  APPROVED_PAID
  REJECTED
  WAITLISTED
}

enum VolunteerApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  DECLINED
  WAITLISTED
}

enum VolunteerPreferredContactMethod {
  EMAIL
  PHONE
  SMS
  DISCORD
  OTHER
}

enum VolunteerAssignmentState {
  INTERESTED
  PREVIOUS_EXPERIENCE
  AVOID
  REQUESTED_BY_LEAD
  ASSIGNED
}

enum EmailTemplateScope {
  SYSTEM
  ORGANIZATION
  EVENT
}

enum EmailTemplateKey {
  ORGANIZATION_INVITE
  EVENT_INVITE
  REGISTRATION_CONFIRMATION
  VENDOR_APPLICATION_RECEIVED
  VOLUNTEER_APPLICATION_RECEIVED
  ORDER_RECEIPT
}

enum EmailLogStatus {
  SKIPPED
  SENT
  FAILED
}

enum EmailProvider {
  RESEND
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrganizationMember[]
  events    Event[]
  invites   OrganizationInvite[]
  auditLogs AuditLog[]
  emailTemplates EmailTemplate[]
  emailLogs EmailLog[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInvite {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole
  token          String           @unique
  status         InviteStatus     @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("OrganizationInviteCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([email])
}

model Event {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  slug           String
  status         EventStatus @default(DRAFT)
  timezone       String
  startsAt       DateTime?
  endsAt         DateTime?
  venueName      String?
  contactEmail   String?
  description    String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      EventMember[]
  invites      EventInvite[]
  auditLogs    AuditLog[]
  products     Product[]
  registrationQuestions RegistrationQuestion[]
  registrations Registration[]
  attendeeProfiles AttendeeProfile[]
  carts       Cart[]
  orders      Order[]
  payments    Payment[]
  refunds     Refund[]
  stripeWebhookEvents StripeWebhookEvent[]
  vendorApplications VendorApplication[]
  volunteerApplications VolunteerApplication[]
  volunteerDepartments VolunteerDepartment[]
  emailTemplates EmailTemplate[]
  emailLogs EmailLog[]

  @@unique([slug])
  @@index([organizationId])
}

model EventMember {
  id        String    @id @default(cuid())
  eventId   String
  userId    String
  role      EventRole
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model EventInvite {
  id          String       @id @default(cuid())
  eventId     String
  email       String
  role        EventRole
  token       String       @unique
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User  @relation("EventInviteCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@index([email])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  eventId        String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([eventId, createdAt])
  @@index([actorUserId])
}

model Product {
  id             String          @id @default(cuid())
  eventId        String
  category       ProductCategory
  name           String
  displayName    String
  description    String?         @db.Text
  basePriceCents Int
  stockLimit     Int?
  publicVisible  Boolean         @default(true)
  archivedAt     DateTime?
  availableFrom  DateTime?
  availableUntil DateTime?
  minPurchaseAge Int?
  maxPurchaseAge Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  images         ProductImage[]
  options        ProductOption[]
  registrations  Registration[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  vendorApplications VendorApplication[]

  @@index([eventId, category])
  @@index([eventId, publicVisible])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductOption {
  id        String   @id @default(cuid())
  productId String
  label     String
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@index([productId])
}

model ProductOptionValue {
  id        String   @id @default(cuid())
  optionId  String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId])
}

model AttendeeProfile {
  id        String   @id @default(cuid())
  eventId   String
  userId    String?
  email     String
  firstName String
  lastName  String
  birthDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  registrations Registration[]

  @@index([eventId])
  @@index([userId])
  @@index([email])
}

model Registration {
  id                String             @id @default(cuid())
  eventId           String
  attendeeProfileId String
  userId            String?
  productId         String
  status            RegistrationStatus @default(SUBMITTED)
  checkedInAt       DateTime?
  checkedInByUserId String?
  badgeStatus       BadgeStatus        @default(NOT_PRINTED)
  cashierNote       String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  event           Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendeeProfile AttendeeProfile      @relation(fields: [attendeeProfileId], references: [id], onDelete: Cascade)
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  product         Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  checkedInBy     User?                @relation("RegistrationCheckedInBy", fields: [checkedInByUserId], references: [id], onDelete: SetNull)
  answers         RegistrationAnswer[]

  @@index([eventId])
  @@index([attendeeProfileId])
  @@index([userId])
  @@index([productId])
  @@index([checkedInByUserId])
  @@index([eventId, checkedInAt])
  @@index([badgeStatus])
}

model RegistrationQuestion {
  id        String                   @id @default(cuid())
  eventId   String
  label     String
  helpText   String?
  type      RegistrationQuestionType @default(SHORT_TEXT)
  required  Boolean                  @default(false)
  sortOrder Int                      @default(0)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  event   Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers RegistrationAnswer[]

  @@index([eventId])
}

model RegistrationAnswer {
  id             String   @id @default(cuid())
  registrationId String
  questionId     String
  value          String   @db.Text
  createdAt      DateTime @default(now())

  registration Registration         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  question     RegistrationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([registrationId, questionId])
  @@index([questionId])
}

model Cart {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@unique([eventId, userId])
  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id                      String      @id @default(cuid())
  eventId                 String
  userId                  String
  status                  OrderStatus @default(UNPAID)
  subtotalCents           Int
  totalCents              Int
  currency                String      @default("usd")
  stripeCheckoutSessionId String?     @unique
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  event    Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]
  refunds  Refund[]
  approvedVendorApplications VendorApplication[] @relation("VendorApprovedOrder")

  @@index([eventId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  productId       String
  productName     String
  productCategory ProductCategory
  unitPriceCents  Int
  quantity        Int
  totalCents      Int
  createdAt       DateTime        @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                      String          @id @default(cuid())
  orderId                 String
  eventId                 String
  provider                PaymentProvider
  status                  PaymentStatus
  amountCents             Int
  currency                String          @default("usd")
  stripePaymentIntentId   String?
  stripeCheckoutSessionId String?
  offlineNote             String?
  markedByUserId          String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  order        Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event        Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  markedByUser User? @relation("PaymentMarkedBy", fields: [markedByUserId], references: [id], onDelete: SetNull)
  refunds      Refund[]

  @@index([orderId])
  @@index([eventId])
  @@index([stripeCheckoutSessionId])
  @@index([stripePaymentIntentId])
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  paymentId       String?
  eventId         String
  status          RefundStatus @default(PENDING)
  amountCents     Int
  reason          String?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment       Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdByUser User?    @relation("RefundCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([paymentId])
  @@index([eventId])
}

model StripeWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  eventId       String?
  type          String
  payload       Json
  processedAt   DateTime @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([type])
}

model VendorApplication {
  id                      String                  @id @default(cuid())
  eventId                 String
  userId                  String
  businessName            String
  contactName             String
  contactEmail            String
  description             String                  @db.Text
  productsServices        String                  @db.Text
  requestedTableProductId String?
  status                  VendorApplicationStatus @default(SUBMITTED)
  seatingNotes            String?                 @db.Text
  adminNote               String?                 @db.Text
  approvedOrderId         String?                 @unique
  reviewedByUserId        String?
  submittedAt             DateTime                @default(now())
  reviewedAt              DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  event                 Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                  User                @relation("VendorApplicant", fields: [userId], references: [id], onDelete: Cascade)
  requestedTableProduct Product?            @relation(fields: [requestedTableProductId], references: [id], onDelete: SetNull)
  approvedOrder         Order?              @relation("VendorApprovedOrder", fields: [approvedOrderId], references: [id], onDelete: SetNull)
  reviewedBy            User?               @relation("VendorReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  amenities             VendorAmenity[]
  assistants            VendorAssistant[]
  seatingPreferences    VendorSeatingPreference[]

  @@index([eventId, status])
  @@index([userId, createdAt])
  @@index([requestedTableProductId])
}

model VendorAmenity {
  id            String   @id @default(cuid())
  applicationId String
  name          String
  details       String?
  createdAt     DateTime @default(now())

  application VendorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model VendorAssistant {
  id            String   @id @default(cuid())
  applicationId String
  name          String
  email         String?
  createdAt     DateTime @default(now())

  application VendorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model VendorSeatingPreference {
  id            String   @id @default(cuid())
  applicationId String
  note          String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  application VendorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model VolunteerApplication {
  id                     String                          @id @default(cuid())
  eventId                String
  userId                 String?
  firstName              String
  lastName               String
  email                  String
  phone                  String?
  preferredContactMethod VolunteerPreferredContactMethod @default(EMAIL)
  availability           String                          @db.Text
  departmentInterests    String                          @db.Text
  priorExperience        String?                         @db.Text
  status                 VolunteerApplicationStatus      @default(SUBMITTED)
  adminNote              String?                         @db.Text
  reviewedByUserId       String?
  submittedAt            DateTime                        @default(now())
  reviewedAt             DateTime?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  event      Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User?                 @relation("VolunteerApplicant", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy User?                @relation("VolunteerReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  assignments VolunteerAssignment[]

  @@index([eventId, status])
  @@index([userId, createdAt])
  @@index([email])
}

model VolunteerDepartment {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String?  @db.Text
  leadUserId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  leadUser    User?                 @relation("VolunteerDepartmentLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  assignments VolunteerAssignment[]

  @@unique([eventId, name])
  @@index([eventId])
  @@index([leadUserId])
}

model VolunteerAssignment {
  id            String                   @id @default(cuid())
  applicationId String
  departmentId  String
  state         VolunteerAssignmentState @default(INTERESTED)
  note          String?                  @db.Text
  createdByUserId String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  application   VolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  department    VolunteerDepartment  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdByUser User?                @relation("VolunteerAssignmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([applicationId, departmentId])
  @@index([departmentId, state])
  @@index([createdByUserId])
}

model EmailTemplate {
  id             String             @id @default(cuid())
  scope          EmailTemplateScope
  key            EmailTemplateKey
  organizationId String?
  eventId        String?
  name           String
  subject        String
  bodyText       String             @db.Text
  bodyHtml       String?            @db.Text
  enabled        Boolean            @default(true)
  nonCritical    Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  emailLogs    EmailLog[]

  @@index([scope, key])
  @@index([organizationId, key])
  @@index([eventId, key])
}

model EmailLog {
  id                String         @id @default(cuid())
  organizationId    String?
  eventId           String?
  templateId        String?
  toEmail           String
  subject           String
  status            EmailLogStatus
  provider          EmailProvider?
  providerMessageId String?
  error             String?        @db.Text
  payload           Json?
  createdAt         DateTime       @default(now())

  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template     EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([eventId, createdAt])
  @@index([templateId])
  @@index([status, createdAt])
}
